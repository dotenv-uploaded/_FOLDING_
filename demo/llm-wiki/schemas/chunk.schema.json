{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegate.local/schemas/chunk.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "chunk_id",
    "document_id",
    "file_version_id",
    "section",
    "text",
    "text_sha256",
    "ordinal"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "chunk_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{6}$"},
    "file_version_id": {"type": "string", "minLength": 1},
    "section": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ordinal": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
