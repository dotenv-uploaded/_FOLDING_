{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegate.local/schemas/link.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "target_id",
    "relation",
    "status",
    "evidence_chunk_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{6}$"},
    "target_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{6}$"},
    "relation": {"enum": ["IMPLEMENTED_BY", "VERIFIED_BY", "REFERENCES"]},
    "status": {"enum": ["VERIFIED", "PROPOSED"]},
    "evidence_chunk_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
