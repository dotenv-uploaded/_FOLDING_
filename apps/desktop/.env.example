# CODEGATE 설정 — 이 파일 하나만 본다.
#
# `.env` 로 복사해 값을 채운다. `pnpm dev`, `pnpm dev:integrated`, 설치본 모두 같은 파일을
# 읽는다(src/main/env.ts). **실제 환경변수가 있으면 그쪽이 이긴다** — `.env` 는 빈 자리만 채운다.
#
# `.env` 는 gitignore 대상이다. 자격증명을 예제 파일에 적지 말 것.

# ── 모듈 경로 ────────────────────────────────────────────────────────────
# 이 monorepo에서는 비워 둔다. 외부 checkout을 연결할 때만 절대 경로를 설정한다.

# 민규 — doc2md (문서 → Markdown 변환)
# CODEGATE_DOC2MD_PROJECT_ROOT=/absolute/path/to/services/doc2md
# CODEGATE_DOC2MD_PYTHON=/absolute/path/to/services/doc2md/.venv/bin/python
# 별도로 띄운 doc2md 에 붙을 때만. dev:integrated 는 직접 띄우고 이 값을 자동으로 넣는다.
# CODEGATE_DOC2MD_URL=http://127.0.0.1:9000

# 성주 — codegate-local sidecar (에이전트 · 변경계획 · 실행)
# CODEGATE_SIDECAR_BIN=/absolute/path/to/services/agent/.venv/bin/codegate-local

# 용휘 — LLMWIKI 빌더
# CODEGATE_LLMWIKI_PROJECT_ROOT=/absolute/path/to/packages/llmwiki

# ── 인증 ─────────────────────────────────────────────────────────────────
# local  = 로그인 우회 (개발 기본값)
# cloud  = 실제 Google OAuth. CODEGATE_CLOUD_API_URL 이 가리키는 서버로 붙는다.
CODEGATE_AUTH_MODE=local
# CODEGATE_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
# Google Console "승인된 리디렉션 URI" 와 **글자 그대로** 같아야 한다 (경로까지 정확히).
# CODEGATE_OAUTH_REDIRECT_URI=http://127.0.0.1:47821/auth/callback

# ── 로컬 문서 분석·채팅 LLM ─────────────────────────────────────────────
# 기본값은 API 키가 없는 Gemma 4다. auto는 Ollama → LM Studio → 설치본 내장 Ollama 순서다.
CODEGATE_AGENT_MODE=local
CODEGATE_LLM_PROVIDER=local
CODEGATE_LOCAL_LLM_BACKEND=auto
CODEGATE_LOCAL_LLM_MODEL=gemma4:e2b
CODEGATE_LOCAL_LLM_CONTEXT_TOKENS=8192
CODEGATE_LOCAL_LLM_MAX_OUTPUT_TOKENS=2048
# 기존 loopback 서버를 고정할 때만:
# CODEGATE_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CODEGATE_LOCAL_LLM_API_TOKEN=

# ── 선택적 상용 provider ─────────────────────────────────────────────────
# 상용 배포에서만 provider와 키를 명시한다. 로컬 기본값은 이 값을 읽어 외부로 전송하지 않는다.
# CODEGATE_AGENT_MODE=claude
# CODEGATE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# CODEGATE_CLAUDE_MODEL=<exact-model-id>
# CODEGATE_CLAUDE_TIMEOUT_SECONDS=180

# Discord 메시지를 Folding LLMWiki의 read-only 외부 지식으로 동기화합니다.
# 채널 ID allowlist는 필수입니다. 전체 허용은 CODEGATE_DISCORD_CHANNEL_ALLOWLIST=* 로 명시합니다.
# CODEGATE_DISCORD_ENABLED=true
# CODEGATE_DISCORD_BOT_TOKEN=
# CODEGATE_DISCORD_GUILD_ID=123456789012345678
# CODEGATE_DISCORD_CHANNEL_ALLOWLIST=234567890123456789
# CODEGATE_DISCORD_GATEWAY_ENABLED=true
# CODEGATE_DISCORD_REBUILD_DEBOUNCE_SECONDS=5
# LLM 없이 파이프라인 계약만 돌릴 때
# CODEGATE_AGENT_MODE=deterministic

# ── 원격 에이전트 서버에 붙기 ─────────────────────────────────────────────
# 켜면 로컬 sidecar 를 띄우지 않고 그 서버에 붙는다.
# 주의: 그 서버는 **자기 코퍼스**로 답한다 — 이 컴퓨터에 등록한 폴더가 아니다.
# CODEGATE_SIDECAR_URL=https://example.up.railway.app/api/v1
