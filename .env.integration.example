# 로컬 개발 기본 배치에서는 sibling Backend/LLMWIKI를 자동 탐색한다.
# 다른 위치를 사용할 때만 아래 값을 export한다.
CODEGATE_AUTH_MODE=local
CODEGATE_AGENT_MODE=deterministic
CODEGATE_SIDECAR_BIN=/absolute/path/to/codegate-local
CODEGATE_LLMWIKI_PROJECT_ROOT=/absolute/path/to/LLMWIKI
CODEGATE_LLMWIKI_INPUT_ROOT=/absolute/path/to/source-md
CODEGATE_LLMWIKI_STORAGE_ROOT=/absolute/path/to/llmwiki-storage
CODEGATE_SIDECAR_DATA_ROOT=/absolute/path/to/app-data

# 민규 산출물 연결 시
CODEGATE_DOC2MD_URL=http://127.0.0.1:9000
CODEGATE_CONVERT_MODULE=@codegate/convert
CODEGATE_KORDOC_BIN=/absolute/path/to/kordoc

# 용휘 산출물 연결 시
CODEGATE_BUILDER_MODULE=@codegate/wiki-builder
